# Copy to .env. Never commit real values.
DATABASE_URL=postgresql+psycopg://apex:change-me@localhost:5432/apex
REDIS_URL=redis://localhost:6379/0
OPENF1_TOKEN=            # paid OpenF1 key: required for real-time data during sessions
API_KEY=                 # set to require X-API-Key on every /api call
RATE_LIMIT_PER_MINUTE=120
FORCE_HTTPS=1
LIVE_POLL_SECONDS=4
EXTRA_SEASONS=2025
