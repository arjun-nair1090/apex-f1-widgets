{
 "type": "AdaptiveCard",
 "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
 "version": "1.6",
 "body": [
  {
   "type": "TextBlock",
   "text": "Customize",
   "wrap": false,
   "size": "Medium",
   "weight": "Bolder"
  },
  {
   "type": "Input.ChoiceSet",
   "id": "driver",
   "label": "Driver",
   "value": "${driver}",
   "choices": [
    {
     "$data": "${drivers}",
     "title": "${title}",
     "value": "${value}"
    }
   ]
  },
  {
   "type": "Input.ChoiceSet",
   "id": "density",
   "label": "Information",
   "value": "${density}",
   "style": "expanded",
   "choices": [
    {
     "title": "Minimal",
     "value": "minimal"
    },
    {
     "title": "Standard",
     "value": "standard"
    },
    {
     "title": "Detailed",
     "value": "detailed"
    }
   ]
  }
 ],
 "actions": [
  {
   "type": "Action.Execute",
   "title": "Save",
   "verb": "save"
  },
  {
   "type": "Action.Execute",
   "title": "Cancel",
   "verb": "cancel"
  }
 ]
}