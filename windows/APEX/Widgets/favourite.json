{
 "type": "AdaptiveCard",
 "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
 "version": "1.6",
 "body": [
  {
   "type": "Container",
   "items": [
    {
     "type": "TextBlock",
     "text": "FAVOURITE DRIVER",
     "wrap": false,
     "size": "Small",
     "weight": "Bolder",
     "isSubtle": true
    },
    {
     "type": "Container",
     "height": "stretch",
     "items": []
    },
    {
     "type": "TextBlock",
     "text": "Choose a driver",
     "wrap": false,
     "size": "Medium",
     "weight": "Bolder"
    },
    {
     "type": "TextBlock",
     "text": "Open the widget menu, then Customize.",
     "wrap": true,
     "size": "Small",
     "isSubtle": true,
     "spacing": "None"
    }
   ],
   "$when": "${!chosen}",
   "height": "stretch"
  },
  {
   "type": "Container",
   "items": [
    {
     "type": "TextBlock",
     "text": "${label}",
     "wrap": false,
     "size": "Small",
     "weight": "Bolder",
     "color": "${if(live,'Attention','Default')}",
     "isSubtle": "${!live}"
    },
    {
     "type": "ColumnSet",
     "columns": [
      {
       "type": "Column",
       "width": "stretch",
       "items": [
        {
         "type": "Container",
         "height": "stretch",
         "items": []
        },
        {
         "type": "TextBlock",
         "text": "${big}",
         "wrap": false,
         "size": "ExtraLarge",
         "weight": "Bolder"
        },
        {
         "type": "TextBlock",
         "text": "${name}",
         "wrap": false,
         "size": "Medium",
         "weight": "Bolder",
         "spacing": "None"
        },
        {
         "type": "TextBlock",
         "text": "${sub}",
         "wrap": false,
         "size": "Small",
         "isSubtle": true,
         "spacing": "None"
        }
       ],
       "verticalContentAlignment": "Bottom"
      },
      {
       "type": "Column",
       "width": "auto",
       "items": [
        {
         "type": "TextBlock",
         "text": "${number}",
         "wrap": false,
         "size": "ExtraLarge",
         "weight": "Bolder",
         "isSubtle": true,
         "horizontalAlignment": "Right",
         "$when": "${number != ''}"
        },
        {
         "type": "Image",
         "url": "${silhouette}",
         "height": "72px",
         "horizontalAlignment": "Right",
         "spacing": "None",
         "altText": "${name}",
         "$when": "${silhouette != ''}"
        }
       ],
       "verticalContentAlignment": "Bottom",
       "$when": "${$host.widgetSize==\"small\"}"
      },
      {
       "type": "Column",
       "width": "auto",
       "items": [
        {
         "type": "TextBlock",
         "text": "${number}",
         "wrap": false,
         "size": "ExtraLarge",
         "weight": "Bolder",
         "isSubtle": true,
         "horizontalAlignment": "Right",
         "$when": "${number != ''}"
        },
        {
         "type": "Image",
         "url": "${silhouette}",
         "height": "110px",
         "horizontalAlignment": "Right",
         "spacing": "None",
         "altText": "${name}",
         "$when": "${silhouette != ''}"
        }
       ],
       "verticalContentAlignment": "Bottom",
       "$when": "${$host.widgetSize==\"medium\"}"
      }
     ],
     "height": "stretch",
     "$when": "${$host.widgetSize!=\"large\"}"
    },
    {
     "type": "Container",
     "items": [
      {
       "type": "ColumnSet",
       "columns": [
        {
         "type": "Column",
         "width": "stretch",
         "items": [
          {
           "type": "Container",
           "height": "stretch",
           "items": []
          }
         ]
        },
        {
         "type": "Column",
         "width": "auto",
         "items": [
          {
           "type": "TextBlock",
           "text": "${number}",
           "wrap": false,
           "size": "ExtraLarge",
           "weight": "Bolder",
           "isSubtle": true,
           "horizontalAlignment": "Right",
           "$when": "${number != ''}"
          },
          {
           "type": "Image",
           "url": "${silhouette}",
           "height": "220px",
           "horizontalAlignment": "Right",
           "spacing": "None",
           "altText": "${name}",
           "$when": "${silhouette != ''}"
          }
         ],
         "verticalContentAlignment": "Bottom"
        }
       ]
      },
      {
       "type": "Container",
       "height": "stretch",
       "items": []
      },
      {
       "type": "TextBlock",
       "text": "${big}",
       "wrap": false,
       "size": "ExtraLarge",
       "weight": "Bolder"
      },
      {
       "type": "TextBlock",
       "text": "${name}",
       "wrap": false,
       "size": "Large",
       "weight": "Bolder",
       "spacing": "None"
      },
      {
       "type": "TextBlock",
       "text": "${sub}",
       "wrap": false,
       "size": "Small",
       "isSubtle": true,
       "spacing": "None"
      }
     ],
     "$when": "${$host.widgetSize==\"large\"}",
     "height": "stretch"
    }
   ],
   "$when": "${chosen}",
   "height": "stretch"
  },
  {
   "type": "TextBlock",
   "text": "${stale}",
   "wrap": false,
   "size": "Small",
   "isSubtle": true,
   "spacing": "Small",
   "$when": "${stale != ''}"
  }
 ]
}