{
  "$comment": "APEX design tokens. Single source of truth: ios/Shared/Tokens.swift, android/app/src/main/java/club/apex/Core.kt and backend/apex/preview/index.html mirror these values by hand (Windows cards use semantic system colors). Change here first.",
  "color": {
    "dark": {
      "background": "#08090B",
      "surface": "#111318",
      "elevated": "#181B21",
      "border": "#23262E",
      "textPrimary": "#F5F7FA",
      "textSecondary": "#9298A3",
      "textTertiary": "#5C626D"
    },
    "amoled": {
      "background": "#000000",
      "surface": "#000000",
      "elevated": "#0C0D10",
      "border": "#1C1F25",
      "textPrimary": "#F5F7FA",
      "textSecondary": "#9298A3",
      "textTertiary": "#5C626D"
    },
    "light": {
      "background": "#F3F4F6",
      "surface": "#FFFFFF",
      "elevated": "#F7F8FA",
      "border": "#E2E4E9",
      "textPrimary": "#0B0D11",
      "textSecondary": "#5A606B",
      "textTertiary": "#8C919B"
    },
    "accent": {
      "signal": "#FF5A1F",
      "signalOnLight": "#E0440C"
    },
    "status": {
      "live": "#FF5A1F",
      "sectorOverall": "#A879FF",
      "sectorPersonal": "#2FD27F",
      "sectorNone": "#E8C547",
      "pit": "#9298A3"
    }
  },
  "status": {
    "$comment": "Never color alone (spec §28): every status has a glyph.",
    "live": { "glyph": "●", "label": "LIVE" },
    "upcoming": { "glyph": "○", "label": "UPCOMING" },
    "startingSoon": { "glyph": "◐", "label": "SOON" },
    "finished": { "glyph": "✓", "label": "FINISHED" },
    "sectorOverall": { "glyph": "◆" },
    "sectorPersonal": { "glyph": "▲" },
    "sectorNone": { "glyph": "–" },
    "pit": { "glyph": "PIT" }
  },
  "typography": {
    "family": { "sans": "Geist", "mono": "Geist Mono", "iosSans": "SF Pro (system)", "iosMono": "SF Mono (system monospaced digits)", "androidSans": "system sans-serif (Glance widgets)", "androidMono": "system monospace", "windowsSans": "Segoe UI (widget type ramp; digits are tabular)" },
    "numerals": "tabular",
    "scale": {
      "hero":    { "size": 44, "weight": 600, "tracking": -1.5, "font": "mono" },
      "display": { "size": 32, "weight": 600, "tracking": -1.0, "font": "mono" },
      "title":   { "size": 17, "weight": 600, "tracking": -0.2, "font": "sans" },
      "body":    { "size": 14, "weight": 500, "tracking": 0,    "font": "sans" },
      "data":    { "size": 13, "weight": 500, "tracking": 0,    "font": "mono" },
      "meta":    { "size": 11, "weight": 600, "tracking": 0.8,  "font": "sans", "case": "upper" },
      "micro":   { "size": 9,  "weight": 600, "tracking": 0.8,  "font": "sans", "case": "upper" }
    }
  },
  "spacing": { "unit": 8, "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radius": { "xs": 2, "s": 4, "m": 8, "widget": "platform" },
  "border": { "hairline": 1 },
  "shadow": {
    "soft": { "y": 1, "blur": 2, "color": "#000000", "opacity": 0.24 },
    "raised": { "y": 8, "blur": 24, "color": "#000000", "opacity": 0.32 }
  },
  "rail": {
    "$comment": "The APEX signature: a 2px progress trace along the bottom edge (lap progress, countdown progress).",
    "height": 2,
    "track": "border",
    "fill": "textPrimary",
    "fillLive": "signal"
  },
  "motion": {
    "fast": { "durationMs": 160, "curve": "easeOut" },
    "standard": { "durationMs": 240, "curve": "easeInOut" },
    "spring": { "response": 0.35, "damping": 0.86 },
    "livePulse": { "durationMs": 2000, "minOpacity": 0.45, "maxOpacity": 1.0 },
    "reducedMotion": "Replace movement with an opacity crossfade; stop the live pulse."
  },
  "icon": { "style": "1.5px stroke, square caps, 16/20/24 grid", "set": "SF Symbols / Material Symbols Sharp / Segoe Fluent Icons" },
  "format": {
    "lapTime": "m:ss.SSS",
    "gap": "+s.SSS | +N LAP(S)",
    "countdownUnder24h": "HH:MM:SS",
    "countdownOver24h": "DD DAYS + HH:MM:SS",
    "position": "P{n} (prose) | {n} (tables, 2-digit padded in standings: 01)",
    "points": "{n} PTS (integer unless .5)",
    "sessionTime": "EEE · HH:mm in the user's local time zone, uppercase",
    "lap": "L{n} / {total}",
    "updated": "LAST UPDATED {n}s|m|h AGO"
  }
}
